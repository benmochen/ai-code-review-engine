# Application Configuration
# Copy this file to .env and fill in the values before deploying:
#   cp .env.example .env

# Database & Redis URLs (defaults configured for docker-compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/reviewbot
REDIS_URL=redis://redis:6379/0

# GitHub OAuth Application credentials (create at https://github.com/settings/developers)
# Authorization callback URL in GitHub must match: <PUBLIC_BASE_URL>/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Secret used to verify incoming GitHub webhooks (fallback/default)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=generate_a_random_32_char_hex_secret

# Session secret used to sign session cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate_another_random_32_char_hex_secret

# Public origin of your deployed bot that GitHub can reach (e.g., https://reviewbot.example.com or ngrok URL in dev)
# Required for GitHub webhooks to be delivered to your server.
PUBLIC_BASE_URL=https://your-public-domain.com

# Anthropic Claude API Key for reviewing PR diffs
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude model to use for reviews
CLAUDE_MODEL=claude-3-5-sonnet-20241022
